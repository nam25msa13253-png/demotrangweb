# ==== Database (PostgreSQL) ====
# Tren Render: DATABASE_URL duoc render.yaml tu dien (fromDatabase) khi Apply Blueprint,
# khong can dien tay. Chi dung cac bien DB_HOST/... rieng le neu chay Postgres local/khac.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_queue
DB_USER=postgres
DB_PASSWORD=
# Dat true neu Postgres yeu cau SSL (Render Postgres qua DATABASE_URL noi bo thi khong can).
DB_SSL=false

# ==== Server ====
SERVER_PORT=3000
# WebSocket duoc tich hop chung voi HTTP server (cung mot port) qua thu vien `ws`.

# Danh sach domain duoc phep goi API tu trinh duyet (CORS), cach nhau boi dau phay.
# Doi ten mien tren Render: chi can sua bien nay tren Render Dashboard -> Environment,
# KHONG can sua code/deploy lai. Bo trong se dung mac dinh domain Render hien tai + localhost.
# VD: CORS_ORIGIN=https://ten-mien-cu.onrender.com,https://ten-mien-moi-cua-ban.com
CORS_ORIGIN=

# ==== AI Chatbot (tro ly ao ho tro Kiosk - dung Google Gemini API) ====
# Lay API key tai https://aistudio.google.com/apikey - KHONG commit key that len git.
GEMINI_API_KEY=

# Luu y: Cac tham so nghiep vu dong (Call Timeout, Max Retry, Audio Gap, Undo Buffer,
# Max Ticket Lifetime, cac nguong canh bao, EOD Purge Hour...) KHONG nam trong .env.
# Chung duoc luu trong bang `system_configs` (xem db/schema.sql) va chinh sua truc tiep
# qua Admin Dashboard (tab "Cau hinh Tham so") theo dung tinh than Dynamic Policy Engine
# - khong can sua code / deploy lai de thay doi.
