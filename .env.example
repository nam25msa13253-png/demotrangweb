# ==== Database (PostgreSQL tren Neon) ====
# CSDL dung Neon (Postgres mien phi, khong het han). Lay chuoi ket noi tai bang dieu khien
# Neon -> muc "Connection string", dan nguyen ca chuoi vao DATABASE_URL:
#   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Khi da co DATABASE_URL thi cac bien DB_HOST/DB_PORT/... ben duoi bi bo qua.
DATABASE_URL=

# Chi dung khi chay Postgres cai tai cho (khong dien DATABASE_URL).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_queue
DB_USER=postgres
DB_PASSWORD=

# Quy tac SSL (ap dung giong nhau cho ca server lan script db/init.js):
#   - Co DATABASE_URL  -> tu dong BAT SSL. Dat DB_SSL=false neu muon tat.
#   - Khong co          -> tu dong TAT SSL. Dat DB_SSL=true neu Postgres tai cho yeu cau.
# Neon bat buoc SSL nen cu de true cho ro rang.
DB_SSL=true

# Tuy chon: tro toi file chung chi CA neu muon xac thuc chung chi that thay vi bo qua.
# DB_SSL_CA=

# Mui gio cho tien trinh Node. Bat buoc dat tren may chu cloud (mac dinh la UTC), neu khong
# gio chay Batch Purge cuoi ngay se lech 7 tieng so voi gio lam viec thuc te.
TZ=Asia/Ho_Chi_Minh

# ==== Server ====
SERVER_PORT=3000
# WebSocket duoc tich hop chung voi HTTP server (cung mot port) qua thu vien `ws`.

# Domain duoc phep goi API tu trinh duyet (CORS) duoc khai bao TRUC TIEP trong code
# (xem ALLOWED_ORIGINS trong src/server.js) de de doi - doi ten mien chi can sua mang do
# roi git push, khong dung bien moi truong.

# ==== AI Chatbot (tro ly ao ho tro Kiosk - dung Google Gemini API) ====
# Lay API key tai https://aistudio.google.com/apikey - KHONG commit key that len git.
GEMINI_API_KEY=

# Luu y: Cac tham so nghiep vu dong (Call Timeout, Max Retry, Audio Gap, Undo Buffer,
# Max Ticket Lifetime, cac nguong canh bao, EOD Purge Hour...) KHONG nam trong .env.
# Chung duoc luu trong bang `system_configs` (xem db/schema.sql) va chinh sua truc tiep
# qua Admin Dashboard (tab "Cau hinh Tham so") theo dung tinh than Dynamic Policy Engine
# - khong can sua code / deploy lai de thay doi.
